{
  "name": "faun",
  "private": true,
  "description": "Faun — an open design system for agentic enterprise software.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "tokens": "pnpm --filter @faun-ds/tokens build",
    "changeset": "changeset",
    "release": "turbo build && changeset publish",
    "dev": "pnpm --filter @faun-ds/docs dev",
    "docs:build": "pnpm build:llms && pnpm --filter @faun-ds/docs build",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "check:icons": "node scripts/check-icons.mjs",
    "readme:shots": "node scripts/readme-shots.mjs",
    "format": "prettier --write .",
    "build:llms": "node scripts/build-llms.mjs",
    "lint": "eslint .",
    "preflight": "node scripts/preflight-publish.mjs",
    "check:generated": "node scripts/check-generated.mjs",
    "rename-scope": "node scripts/rename-scope.mjs",
    "set-owner": "node scripts/set-owner.mjs",
    "check:pages": "node scripts/pages-smoke.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.11",
    "@playwright/test": "1.64.1",
    "playwright": "1.64.1",
    "prettier": "^3.4.2",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SaquibPM/faun-design-system.git"
  },
  "homepage": "https://saquibpm.github.io/faun-design-system",
  "bugs": {
    "url": "https://github.com/SaquibPM/faun-design-system/issues"
  }
}
