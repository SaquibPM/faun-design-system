  "motion": {
    "duration": {
      "$type": "duration",
      "instant": {
        "$value": "0ms"
      },
      "fast": {
        "$value": "120ms",
        "$description": "Hover, press, toggle, colour changes."
      },
      "moderate": {
        "$value": "200ms",
        "$description": "Menus, popovers, tooltips, accordions."
      },
      "slow": {
        "$value": "300ms",
        "$description": "Dialogs, sheets, panels."
      },
      "deliberate": {
        "$value": "450ms",
        "$description": "Layout changes, artifact panel, page transitions."
      },
      "pulse": {
        "$value": "1600ms",
        "$description": "Live-agent indicator loop."
      },
      "spin": {
        "$value": "900ms",
        "$description": "Spinner rotation."
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [
          0.2,
          0,
          0,
          1
        ],
        "$description": "Movement within the page."
      },
      "enter": {
        "$value": [
          0,
          0,
          0.2,
          1
        ],
        "$description": "Elements arriving."
      },
      "exit": {
        "$value": [
          0.4,
          0,
          1,
          1
        ],
        "$description": "Elements leaving."
      },
      "emphasized": {
        "$value": [
          0.2,
          0.9,
          0.1,
          1
        ],
        "$description": "Approval gates, completion moments."
      }
    },
    "spring": {
      "$type": "string",
      "$description": "Spring curves as CSS linear(). Fall back to motion.easing.standard where linear() is unsupported.",
      "snappy": {
        "$value": "linear(0, 0.1286, 0.3688, 0.6042, 0.7874, 0.9094, 0.9798, 1.0136, 1.0246, 1.0244, 1.0191, 1.0128, 1.0074, 1.0036, 1.0012, 1, 1)",
        "$description": "Stiffness 400, damping 30, slight overshoot. Use with 450ms: popovers, menus, toggles."
      },
      "gentle": {
        "$value": "linear(0, 0.1229, 0.3429, 0.5383, 0.6942, 0.8004, 0.8723, 0.9209, 0.9507, 0.9696, 0.9817, 0.9888, 0.9933, 0.996, 0.9976, 0.9986, 1)",
        "$description": "Stiffness 170, damping 26, no overshoot. Use with 700ms: sheets, panels, layout."
      }
    }
  },
