{
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "IBM Plex Sans",
          "ui-sans-serif",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "sans-serif"
        ],
        "$description": "Interface and body text."
      },
      "serif": {
        "$value": [
          "IBM Plex Serif",
          "ui-serif",
          "Georgia",
          "serif"
        ],
        "$description": "Display. Page titles, headline figures and editorial moments. Never body text or dense UI."
      },
      "mono": {
        "$value": [
          "IBM Plex Mono",
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "Consolas",
          "monospace"
        ],
        "$description": "Identifiers, codes, schemas."
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500,
        "$description": "Labels, buttons, emphasis, table headers."
      },
      "semibold": {
        "$value": 600,
        "$description": "Headings. The heaviest weight Faun uses."
      }
    },
    "feature": {
      "$type": "string",
      "numeric": {
        "$value": "\"tnum\" 1, \"lnum\" 1",
        "$description": "Tabular lining figures for every number that lines up."
      }
    }
  },
  "type": {
    "$description": "Type roles. Use roles, never raw sizes. Figures use the serif; everything else is IBM Plex Sans. Plex has no optical-size axis, so no role sets font-variation-settings.",
