      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.serif}",
        "fontSize": "52px",
        "lineHeight": "56px",
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": "-0.01em"
      },
      "$description": "Hero figure on overview pages."
    },
    "figure-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.serif}",
        "fontSize": "36px",
        "lineHeight": "40px",
        "fontWeight": "{font.weight.regular}",
