  "elevation": {
    "$type": "shadow",
    "$description": "Five levels. Tinted shadow colours come from the theme; dark themes add a highlight edge; high contrast and print drop shadows, so components also carry a border.",
    "0": {
      "$value": "none"
    },
    "1": {
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px",
          "color": "{shadow.ambient}"
        },
        {
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "0px",
          "color": "{shadow.highlight}",
          "inset": true,
          "offsetYInset": "1px"
        }
      ],
      "$description": "Secondary buttons, inputs."
    },
    "2": {
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px",
          "color": "{shadow.ambient}"
        },
        {
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "8px",
          "spread": "-2px",
          "color": "{shadow.key}"
        },
        {
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "0px",
          "color": "{shadow.highlight}",
          "inset": true,
          "offsetYInset": "1px"
        }
      ],
      "$description": "Cards and panels."
    },
    "3": {
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "4px",
          "spread": "0px",
          "color": "{shadow.ambient}"
        },
        {
          "offsetX": "0px",
          "offsetY": "10px",
          "blur": "24px",
          "spread": "-6px",
          "color": "{shadow.key}"
        },
        {
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "0px",
          "color": "{shadow.highlight}",
          "inset": true,
          "offsetYInset": "1px"
        }
      ],
