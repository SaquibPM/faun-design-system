{
  "name": "@faun-ds/react",
  "version": "0.1.0",
  "description": "Faun Design System React components: accessible, themeable, built on Radix primitives and Faun tokens.",
  "license": "Apache-2.0",
  "author": "Saquib Jawed and Faun contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SaquibPM/faun-design-system.git",
    "directory": "packages/react"
  },
  "homepage": "https://saquibpm.github.io/faun-design-system",
  "bugs": {
    "url": "https://github.com/SaquibPM/faun-design-system/issues"
  },
  "keywords": [
    "react",
    "components",
    "design-system",
    "ui",
    "radix",
    "accessibility",
    "enterprise",
    "agentic",
    "ai"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/styles.css"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/barrel.mjs && tsup && node ../../scripts/use-client.mjs dist/index.js && node scripts/styles.mjs",
    "test": "vitest run",
    "typecheck": "node scripts/barrel.mjs && tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@faun-ds/icons": "workspace:*",
    "@faun-ds/tokens": "workspace:*",
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-avatar": "1.3.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-context-menu": "2.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-hover-card": "1.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-progress": "1.2.1",
    "@radix-ui/react-radio-group": "1.5.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slider": "1.6.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toast": "1.3.1",
    "@radix-ui/react-toggle-group": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@radix-ui/react-visually-hidden": "1.2.13",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "react-day-picker": "9.14.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^22.10.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "jsdom": "25.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsup": "9.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  }
}
