{
  "name": "@faun-ds/ai",
  "version": "0.1.0",
  "description": "Faun agentic components: agent trail, run status, task graph, approval gates, AI drafts with citations, provenance, streaming and prompt input.",
  "license": "Apache-2.0",
  "author": "Saquib Jawed and Faun contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SaquibPM/faun-design-system.git",
    "directory": "packages/ai"
  },
  "homepage": "https://saquibpm.github.io/faun-design-system",
  "bugs": {
    "url": "https://github.com/SaquibPM/faun-design-system/issues"
  },
  "keywords": [
    "react",
    "ai",
    "agents",
    "human-in-the-loop",
    "approval",
    "design-system",
    "enterprise"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/styles.css"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/barrel.mjs && tsup && node ../../scripts/use-client.mjs dist/index.js && node scripts/styles.mjs",
    "test": "vitest run",
    "typecheck": "node scripts/barrel.mjs && tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@faun-ds/icons": "workspace:*",
    "@faun-ds/tokens": "workspace:*",
    "@faun-ds/react": "workspace:*",
    "clsx": "2.1.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@faun-ds/data": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^22.10.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "jsdom": "25.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  }
}
