{
  "name": "@faun-ds/eslint-plugin",
  "version": "0.1.0",
  "description": "ESLint rules that keep product code on the Faun design system: no raw colours, no arbitrary Tailwind values, labelled icon buttons and StatusBadge for status.",
  "license": "Apache-2.0",
  "author": "Saquib Jawed and Faun contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SaquibPM/faun-design-system.git",
    "directory": "packages/eslint-plugin"
  },
  "homepage": "https://saquibpm.github.io/faun-design-system",
  "bugs": {
    "url": "https://github.com/SaquibPM/faun-design-system/issues"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "design-system",
    "tailwind",
    "accessibility"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "eslint": ">=9"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@typescript-eslint/parser": "8.72.0",
    "eslint": "10.13.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  }
}
